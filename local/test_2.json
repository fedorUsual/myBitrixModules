    "UF_CRM_57_1777973032163": "\u0417\u0430\u043a\u0430\u0437\u0447\u0438\u043a: \u041d\u0435\u0444\u0442\u0435\u043f\u0435\u0440\u0435\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0435 \u043f\u0440\u0435\u0434\u043f\u0440\u0438\u044f\u0442\u0438\u0435 \u041e\u041e\u041e \u00ab\u0420\u041d-\u041a\u043e\u043c\u0441\u043e\u043c\u043e\u043b\u044c\u0441\u043a\u0438\u0439 \u041d\u041f\u0417\u00bb (\u041f\u0410\u041e \u00ab\u041d\u041a \u00ab\u0420\u043e\u0441\u043d\u0435\u0444\u0442\u044c\u00bb), \u0425\u0430\u0431\u0430\u0440\u043e\u0432\u0441\u043a\u0438\u0439 \u043a\u0440\u0430\u0439.  \u0421\u043f\u043e\u0441\u043e\u0431 \u0437\u0430\u043a\u0443\u043f\u043a\u0438: \u0417\u0430\u043f\u0440\u043e\u0441 \u0442\u0435\u0445\u043d\u0438\u043a\u043e-\u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0438\u0445 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u043d\u0430 \u042d\u0422\u041f \u0422\u042d\u041a-\u0422\u043e\u0440\u0433, \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0430 \u043d\u043e\u0441\u0438\u0442 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 (\u043e\u043f\u0440\u043e\u0441 \u0440\u044b\u043d\u043a\u0430).  \u041d\u043e\u043c\u0435\u043d\u043a\u043b\u0430\u0442\u0443\u0440\u0430: \u041f\u043e\u0441\u0442\u0430\u0432\u043a\u0430 6 \u043f\u043e\u0437\u0438\u0446\u0438\u0439 \u0437\u0430\u043f\u0430\u0441\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0435\u0439 \u0434\u043b\u044f \u0433\u0430\u0437\u043e\u0432\u044b\u0445 \u043a\u043e\u043c\u043f\u0440\u0435\u0441\u0441\u043e\u0440\u043e\u0432: \u0446\u0438\u043b\u0438\u043d\u0434\u0440\u044b, \u0432\u043e\u0437\u0434\u0443\u0448\u043d\u044b\u0439 \u0444\u0438\u043b\u044c\u0442\u0440, \u043a\u043e\u0440\u043f\u0443\u0441 \u043f\u043e\u0434\u0448\u0438\u043f\u043d\u0438\u043a\u0430, \u0441\u0430\u043b\u044c\u043d\u0438\u043a\u0438. \u0423\u043a\u0430\u0437\u0430\u043d\u044b \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u044b \u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u0438 (Howden, Elliott), \u0430\u043d\u0430\u043b\u043e\u0433\u0438 \u043d\u0435 \u043e\u0433\u043e\u0432\u043e\u0440\u0435\u043d\u044b.  \u0423\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0438: \u041f\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u043d\u0430 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445 DDP \u0438\u043b\u0438 DAP \u0434\u043e \u0441\u043a\u043b\u0430\u0434\u0430 \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0430 (\u0433. \u041a\u043e\u043c\u0441\u043e\u043c\u043e\u043b\u044c\u0441\u043a-\u043d\u0430-\u0410\u043c\u0443\u0440\u0435, \u0443\u043b. \u041b\u0435\u043d\u0438\u043d\u0433\u0440\u0430\u0434\u0441\u043a\u0430\u044f, 115). \u041f\u043b\u0430\u043d\u043e\u0432\u044b\u0435 \u0441\u0440\u043e\u043a\u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0438: \u0438\u044e\u043d\u044c 2026 (\u043f\u043e \u043f\u043e\u0437\u0438\u0446\u0438\u044f\u043c 01.06.2026 \u0438 30.06.2026).  \u0424\u0438\u043d\u0430\u043d\u0441\u044b: \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0446\u0435\u043d\u0430 \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430. \u0412\u0430\u043b\u044e\u0442\u0430 \u2014 \u0440\u0443\u0431\u043b\u0438 \u0420\u0424, \u041d\u0414\u0421 22%. \u041e\u043f\u043b\u0430\u0442\u0430 \u043f\u043e\u0441\u0442\u0444\u0430\u043a\u0442\u0443\u043c \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 70 \u043a\u0430\u043b\u0435\u043d\u0434\u0430\u0440\u043d\u044b\u0445 \u0434\u043d\u0435\u0439, \u043d\u043e \u043d\u0435 \u0440\u0430\u043d\u0435\u0435 45 \u0434\u043d\u0435\u0439 \u043f\u043e\u0441\u043b\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f, \u0431\u0435\u0437 \u0430\u0432\u0430\u043d\u0441\u0430.  \u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u0442\u043e\u0432\u0430\u0440\u0443: \u0422\u043e\u0432\u0430\u0440 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u043d\u043e\u0432\u044b\u043c, \u0440\u0430\u043d\u0435\u0435 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u043c, \u0440\u0435\u043c\u043e\u043d\u0442\u043e\u043f\u0440\u0438\u0433\u043e\u0434\u043d\u044b\u043c, \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u044b\u043c \u043e\u0442 \u043f\u0440\u0430\u0432 \u0442\u0440\u0435\u0442\u044c\u0438\u0445 \u043b\u0438\u0446. \u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0413\u041e\u0421\u0422\/\u0422\u0423 \u0438 \u0442\u0435\u0445\u043d\u0438\u0447\u0435\u0441\u043a\u0438\u043c \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0432 \u0438 \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438.  \u0422\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f \u043a \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0443: \u0423\u0447\u0430\u0441\u0442\u043d\u0438\u043a \u0434\u043e\u043b\u0436\u0435\u043d \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044c \u0441\u0442\u0430\u0442\u0443\u0441 (\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c, \u0434\u0438\u043b\u0435\u0440 \u0438 \u0442.\u043f.) \u0438 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044e\u0449\u0438\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0439 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438 \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u0437\u0430\u043a\u043e\u043d\u043e\u0434\u0430\u0442\u0435\u043b\u044c\u0441\u0442\u0432\u043e\u043c \u0420\u0424.  \u0421\u0440\u043e\u043a\u0438: \u041f\u0440\u0438\u0435\u043c \u0437\u0430\u044f\u0432\u043e\u043a \u0441 30 \u043c\u0430\u0440\u0442\u0430 2026. \u041e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u0435 \u043f\u043e\u0434\u0430\u0447\u0438 \u2014 24 \u0430\u043f\u0440\u0435\u043b\u044f 2026 (\u043f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u0440\u0435\u0434\u0430\u043a\u0446\u0438\u044f). \u041f\u043b\u0430\u043d \u043f\u043e\u0441\u0442\u0430\u0432\u043a\u0438 \u2014 \u0438\u044e\u043d\u044c 2026.  \u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438: \u0416\u0451\u0441\u0442\u043a\u0430\u044f \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0430 \u043a \u0431\u0440\u0435\u043d\u0434\u0443 Howden \u0438 Elliott; \u0443\u0434\u0430\u043b\u0451\u043d\u043d\u044b\u0439 \u0440\u0435\u0433\u0438\u043e\u043d (\u0425\u0430\u0431\u0430\u0440\u043e\u0432\u0441\u043a\u0438\u0439 \u043a\u0440\u0430\u0439); \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u0430\u044f \u043e\u0442\u0441\u0440\u043e\u0447\u043a\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 (\u0434\u043e 70 \u0434\u043d\u0435\u0439); \u043f\u0440\u043e\u0446\u0435\u0434\u0443\u0440\u0430 \u043d\u043e\u0441\u0438\u0442 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440 (\u043d\u0435 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u043a\u0443\u043f\u043a\u0443).",
